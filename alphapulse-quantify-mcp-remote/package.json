{
  "name": "alphapulse-quantify-mcp-remote",
  "version": "0.1.3",
  "description": "Alphapulse Quantify over SSH: the same read-only quant tools, served on the production host for machines without a local aquant checkout.",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": ["alphapulse", "dsh", "deepseek-harness", "mcp", "quant", "ssh"],
  "engines": { "dsh": ">=0.2.2-rc.3" },
  "exports": {
