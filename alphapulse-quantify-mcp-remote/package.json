    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueyue0724/alphapulse-dsh-plugins.git",
    "directory": "alphapulse-quantify-mcp-remote"
  },
  "homepage": "https://github.com/yueyue0724/alphapulse-dsh-plugins#readme",
  "bugs": { "url": "https://github.com/yueyue0724/alphapulse-dsh-plugins/issues" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
